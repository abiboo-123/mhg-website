---
export const prerender = false;

import Layout from "../../../layouts/BaseLayout.astro";
import { createClient } from "@supabase/supabase-js";
import { getSeoMeta } from "../../../utils/seo";

const { lang = "en" } = Astro.params;
const supportedLangs = ["en", "de"];

if (!supportedLangs.includes(lang)) {
  throw new Error(`Invalid language: ${lang}`);
}

const { PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY } = import.meta.env;
const supabase = createClient(PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY);

// Fetch only verified public data
const { data: images } = await supabase
  .from("images")
  .select("id, url, like_count, created_at")
  .eq("verified", true)
  .order("like_count", { ascending: false })
  .order("created_at", { ascending: false });

const heading = lang === "de" ? "🖼️ Galerie" : "🖼️ Gallery";
const noImagesText =
  lang === "de" ? "Noch keine Bilder vorhanden." : "No images yet.";
const backText = lang === "de" ? "Zurück zur Veranstaltung" : "Back to event";
const votingInfo =
  lang === "de"
    ? "Die Bilder mit den meisten ❤️ Likes gewinnen tolle Preise! Unterstütze dein Lieblingsbild."
    : "The artworks with the most ❤️ likes will win amazing prizes! Support your favorite.";

const baseSlug = "childrens-painting-competition-2025/gallery";
const galleryImage = images?.[0]?.url || "/assets/MHG_Logo.svg";

const { title, description, url, imageUrl, imageWidth, imageHeight } =
  getSeoMeta({
    lang,
    titleEn: "Children's Painting Competition 2025 Gallery | MHG Ingolstadt",
    titleDe: "Galerie zum Kinder-Malwettbewerb 2025 | MHG Ingolstadt",
    descEn:
      "Explore the gallery of the Children's Painting Competition 2025 organized by MHG Ingolstadt. View and vote for your favorite artworks created by talented children.",
    descDe:
      "Entdecke die Galerie des Kinder-Malwettbewerbs 2025, organisiert von MHG Ingolstadt. Betrachte und stimme für deine Lieblingskunstwerke talentierter Kinder ab.",
    slug: baseSlug,
    image: galleryImage,
  });
---

<Layout
  lang={lang}
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogUrl={url}
  ogImage={imageUrl}
  ogImageWidth={imageWidth}
  ogImageHeight={imageHeight}
  ogKeywords="Children's Painting Competition Gallery, Kids Art, Voting, Kindermalwettbewerb Galerie, Kinderkunst, Abstimmung"
>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-center">{heading}</h2>
    <p class="text-center text-gray-600 mb-10">{votingInfo}</p>

    <a
      href={`/${lang}/events/childrens-painting-competition-2025`}
      class="inline-block mb-4 text-[#0369a1] hover:underline text-sm"
      aria-label={backText}
    >
      ← {backText}
    </a>

    <div
      id="gallery"
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6"
    >
      {
        images && images.length > 0 ? (
          images.map((img) => (
            <div
              class="bg-white rounded-xl shadow-md p-4 text-center"
              data-id={img.id}
            >
              <a
                href={img.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={
                  lang === "de"
                    ? "Bild in voller Größe anzeigen"
                    : "View full-size artwork"
                }
              >
                <img
                  src={img.url}
                  alt="Artwork"
                  class="rounded-md mb-3 mx-auto w-full h-64 object-contain cursor-pointer transition-transform hover:scale-105"
                />
              </a>

              <button class="like-btn bg-[#0369a1] text-white px-4 py-2 rounded-full hover:bg-blue-800 transition">
                ❤️ {img.like_count}
              </button>
            </div>
          ))
        ) : (
          <p class="text-center text-gray-500 col-span-full">{noImagesText}</p>
        )
      }
    </div>
  </section>

  <script is:inline>
    // Like Button Functionality (German Only)
    document.querySelectorAll(".like-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const card = e.target.closest("[data-id]");
        const id = card.dataset.id;

        const res = await fetch(`/api/likes/${id}`, { method: "POST" });
        const data = await res.json();

        let feedback = card.querySelector(".like-feedback");
        if (!feedback) {
          feedback = document.createElement("div");
          feedback.className = "like-feedback mt-2 text-xs text-gray-600";
          card.appendChild(feedback);
        }

        if (data.success) {
          let currentText = e.target.textContent;
          let currentLikes = parseInt(currentText.replace(/[^\d]/g, "")) || 0;
          let newLikes = currentLikes + 1;
          e.target.textContent = "❤️ " + newLikes;
          feedback.textContent = "✅ Danke für dein Like!";
          feedback.className = "like-feedback mt-2 text-xs text-green-700";
        } else if (data.message) {
          feedback.textContent = "💡 Du hast dieses Bild bereits geliked.";
          feedback.className = "like-feedback mt-2 text-xs text-gray-600";
        }

        setTimeout(() => feedback.remove(), 4000);
      });
    });
  </script>
</Layout>
