---
export const prerender = true;

import Layout from "../../../layouts/BaseLayout.astro";
import { t } from "../../../utils/t";
import { generateStaticPaths } from "../../../utils/i18n";

export async function getStaticPaths() {
  return generateStaticPaths();
}

const { lang } = Astro.params;
const supportedLangs = ["en", "de"];

if (!supportedLangs.includes(lang)) {
  throw new Error(`Invalid language: ${lang}`);
}

// Dynamic Page Content
const pageTitle =
  lang === "de"
    ? "Kindermalwettbewerb – Beitrag hochladen"
    : "Children’s Painting Competition – Upload Entry";

const backText = lang === "de" ? "Zurück zur Veranstaltung" : "Back to Event";

const infoTitle =
  lang === "de"
    ? "Wichtiger Hinweis vor dem Hochladen"
    : "Important Note Before Uploading";

const donationInstructions =
  lang === "de"
    ? "Um an diesem Wohltätigkeitswettbewerb teilzunehmen, ist eine Spende von 5€ über PayPal erforderlich. Bitte gib im Verwendungszweck „Charity Week Painting – <Name des Kindes>“ an. Ohne gültige Spende kann der Beitrag nicht freigeschaltet werden."
    : "To participate in this charity competition, a donation of €5 via PayPal is required. Please include the reference “Charity Week Painting – <Child’s Name>”. Without a valid donation, the artwork cannot be approved.";

const themeReminderTitle =
  lang === "de" ? "Wettbewerbsthema" : "Competition Theme";
const themeReminderText =
  lang === "de"
    ? "Thema: „Gemeinsam sind wir stark!“ – Zeige in deinem Bild, wie Gemeinschaft, Freundschaft oder Glaube Menschen stärken."
    : "Theme: “Together We Are Strong!” – Show through your artwork how community, friendship or faith make us stronger.";

const submitTitle = lang === "de" ? "🖼️ Dein Beitrag" : "🖼️ Your Entry";
const childNameLabel = lang === "de" ? "👶 Name des Kindes" : "👶 Child’s Name";
const parentEmailLabel =
  lang === "de" ? "📧 E-Mail der Eltern" : "📧 Parent’s Email";
const phoneLabel = lang === "de" ? "📞 Telefonnummer" : "📞 Phone Number";
const artworkLabel =
  lang === "de" ? "🎨 Bilddatei (Zeichnung/Fotografie)" : "🎨 Artwork Image";
const artworkHint =
  lang === "de"
    ? "Lade ein Foto oder einen Scan des Kunstwerks hoch (JPG/PNG)."
    : "Upload a photo or scan of the artwork (JPG/PNG).";

const transactionLabel =
  lang === "de"
    ? "💚 Spenden-Nachweis (Screenshot)"
    : "💚 Donation Proof (Screenshot)";
const transactionHint =
  lang === "de"
    ? "Bitte lade den Screenshot der PayPal-Spende hoch, auf dem Verwendungszweck und Betrag erkennbar sind."
    : "Please upload a screenshot of your PayPal donation receipt clearly showing reference and amount.";

const submitBtn = lang === "de" ? "Beitrag hochladen" : "Upload Entry";
const uploadSuccess =
  lang === "de"
    ? "✅ Upload erfolgreich! Dein Beitrag wurde empfangen und wird nach Prüfung freigeschaltet."
    : "✅ Upload successful! Your entry has been received and will be verified before appearing in the gallery.";
const uploadFail =
  lang === "de"
    ? "❌ Upload fehlgeschlagen. Bitte versuche es erneut."
    : "❌ Upload failed. Please try again.";
---

<Layout title={pageTitle} lang={lang}>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h2 class="text-3xl sm:text-4xl font-bold mb-8 text-center">
      🎨 {lang === "de" ? "Beitrag hochladen" : "Upload Your Artwork"}
    </h2>

    <a
      href={`/${lang}/events/childrens-painting-competition-2025`}
      class="inline-block mb-6 text-[#0369a1] hover:underline text-sm"
    >
      ← {backText}
    </a>

    <!-- Donation Info Box -->
    <div
      class="bg-yellow-50 border border-yellow-200 text-yellow-800 p-4 rounded-md mb-6"
    >
      <h3 class="font-semibold mb-2">⚠️ {infoTitle}</h3>
      <p>{donationInstructions}</p>
      <p class="mt-2">
        {lang === "de" ? "PayPal-Link:" : "PayPal link:"}
        <br />
        <a
          href="https://www.paypal.com/paypalme/mhgingolstadt?amount=5&currency=EUR"
          target="_blank"
          class="underline text-[#0369a1]"
        >
          https://www.paypal.com/paypalme/mhgingolstadt?amount=5&currency=EUR
        </a>
      </p>
    </div>

    <!-- Theme Reminder Box -->
    <div
      class="bg-blue-50 border border-blue-200 text-blue-800 p-4 rounded-md mb-8"
    >
      <h3 class="font-semibold mb-2">{themeReminderTitle}</h3>
      <p>{themeReminderText}</p>
    </div>

    <!-- Upload Form -->
    <div class="bg-white rounded-xl shadow-md p-6">
      <h3 class="text-xl font-semibold mb-6">{submitTitle}</h3>

      <form id="uploadForm" class="space-y-5" enctype="multipart/form-data">
        <div>
          <label for="childName" class="block text-sm font-medium mb-1"
            >{childNameLabel}</label
          >
          <input
            type="text"
            id="childName"
            name="childName"
            required
            class="w-full border border-gray-300 p-2 rounded-md"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium mb-1"
            >{parentEmailLabel}</label
          >
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full border border-gray-300 p-2 rounded-md"
          />
        </div>

        <div>
          <label for="phone" class="block text-sm font-medium mb-1"
            >{phoneLabel}</label
          >
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            class="w-full border border-gray-300 p-2 rounded-md"
          />
        </div>

        <hr class="my-6" />

        <div>
          <label for="photo" class="block text-sm font-medium mb-1"
            >{artworkLabel}</label
          >
          <input
            type="file"
            id="photo"
            name="photo"
            accept="image/*"
            required
            class="w-full border border-gray-300 p-2 rounded-md"
          />
          <p class="text-xs text-gray-500 mt-1">{artworkHint}</p>
        </div>

        <div>
          <label for="transaction" class="block text-sm font-medium mb-1"
            >{transactionLabel}</label
          >
          <input
            type="file"
            id="transaction"
            name="transaction"
            accept="image/*"
            required
            class="w-full border border-gray-300 p-2 rounded-md"
          />
          <p class="text-xs text-gray-500 mt-1">{transactionHint}</p>
        </div>

        <button
          type="submit"
          class="w-full bg-[#0369a1] text-white py-2 rounded-full hover:bg-blue-800 transition"
        >
          {submitBtn}
        </button>
      </form>

      <div id="uploadStatus" class="mt-4 text-center text-sm"></div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById("uploadForm");
    const status = document.getElementById("uploadStatus");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      status.textContent = "⏳ Wird hochgeladen...";
      status.className = "mt-4 text-center text-sm text-gray-600";

      try {
        const res = await fetch("/api/upload", {
          method: "POST",
          body: formData,
        });
        const data = await res.json();

        if (res.ok && data.photoUrl) {
          const galleryLink = `/de/childrens-painting-competition-2025/gallery`;

          status.innerHTML = `
            <div class="bg-green-100 text-green-800 border border-green-300 rounded-md p-3 mt-4">
              ✅ Upload erfolgreich!<br/>
              Dein Beitrag wurde empfangen und wird nach Prüfung in der Galerie erscheinen.<br/><br/>
              <a href="${data.photoUrl}" target="_blank" class="underline text-[#0369a1] font-semibold">Bild anzeigen</a>
              &nbsp;|&nbsp;
              <a href="${galleryLink}" class="underline text-[#0369a1] font-semibold">Zur Galerie</a>
            </div>`;
          form.reset();
        } else {
          throw new Error(data.error || "Upload fehlgeschlagen");
        }
      } catch (err) {
        status.innerHTML = `
          <div class="bg-red-100 text-red-800 border border-red-300 rounded-md p-3 mt-4">
            ❌ Etwas ist schiefgelaufen. Bitte versuche es erneut.
          </div>`;
      }
    });
  </script>
</Layout>
