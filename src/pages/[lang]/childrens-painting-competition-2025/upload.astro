---
import Layout from "../../../layouts/BaseLayout.astro";
import { t } from "../../../utils/t";

const { lang } = Astro.params;
const supportedLangs = ["en", "de"];

// Generate static paths
export async function getStaticPaths() {
  return supportedLangs.map((lang) => ({ params: { lang } }));
}

if (!supportedLangs.includes(lang)) {
  throw new Error(`Invalid language: ${lang}`);
}
---

<Layout title="Children’s Painting Competition – Upload" lang={lang}>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h2 class="text-3xl sm:text-4xl font-bold mb-10 text-center">
      🎨 {
        t("competition.uploadTitle", lang) || "Children’s Painting Competition"
      }
    </h2>

    <a
      href={`/${lang}/events/childrens-painting-competition-2025`}
      class="inline-block mb-4 text-[#0369a1] hover:underline text-sm"
    >
      ← {lang === "de" ? "Zurück zur Veranstaltung" : "Back to event"}
    </a>

    <div class="bg-white rounded-xl shadow-md p-6">
      <h3 class="text-xl font-semibold mb-6">
        🖼️ {t("competition.uploadFormTitle", lang) || "Submit Your Artwork"}
      </h3>

      <form id="uploadForm" class="space-y-5" enctype="multipart/form-data">
        <!-- Child name -->
        <div>
          <label for="childName" class="block text-sm font-medium mb-1">
            👶 {t("competition.childName", lang) || "Child’s Name"}
          </label>
          <input
            type="text"
            id="childName"
            name="childName"
            required
            class="w-full border border-gray-300 p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-[#0369a1]"
          />
        </div>

        <!-- Parent email -->
        <div>
          <label for="email" class="block text-sm font-medium mb-1">
            📧 {t("competition.parentEmail", lang) || "Parent’s Email"}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full border border-gray-300 p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-[#0369a1]"
          />
        </div>

        <!-- Phone -->
        <div>
          <label for="phone" class="block text-sm font-medium mb-1">
            📞 {t("competition.phone", lang) || "Phone Number"}
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            class="w-full border border-gray-300 p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-[#0369a1]"
          />
        </div>

        <hr class="my-6" />

        <!-- Artwork file -->
        <div>
          <label for="photo" class="block text-sm font-medium mb-1">
            🎨 {t("competition.artwork", lang) || "Artwork Image"}
          </label>
          <input
            type="file"
            id="photo"
            name="photo"
            accept="image/*"
            required
            class="block w-full text-sm text-gray-700 border border-gray-300 rounded-md cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#0369a1]"
          />
          <p class="text-xs text-gray-500 mt-1">
            {
              t("competition.artworkHint", lang) ||
                "Upload your child’s drawing or painting (JPG/PNG)."
            }
          </p>
        </div>

        <!-- Transaction proof file -->
        <div>
          <label for="transaction" class="block text-sm font-medium mb-1">
            💳 {
              t("competition.transactionProof", lang) ||
                "Transaction Proof Image"
            }
          </label>
          <input
            type="file"
            id="transaction"
            name="transaction"
            accept="image/*"
            required
            class="block w-full text-sm text-gray-700 border border-gray-300 rounded-md cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#0369a1]"
          />
          <p class="text-xs text-gray-500 mt-1">
            {
              t("competition.transactionHint", lang) ||
                "Upload a screenshot or receipt showing the participation payment."
            }
          </p>
        </div>

        <button
          type="submit"
          class="w-full bg-[#0369a1] text-white py-2 rounded-full hover:bg-blue-800 transition"
        >
          {t("competition.submitBtn", lang) || "Upload Entry"}
        </button>
      </form>

      <div id="uploadStatus" class="mt-4 text-center text-sm"></div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById("uploadForm");
    const status = document.getElementById("uploadStatus");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      status.textContent = "⏳ Uploading...";
      status.className = "mt-4 text-center text-sm text-gray-600";

      try {
        const res = await fetch("/api/upload", {
          method: "POST",
          body: formData,
        });
        const data = await res.json();

        if (res.ok && data.photoUrl) {
          status.innerHTML = `
            <div class="bg-green-100 text-green-800 border border-green-300 rounded-md p-3 mt-4">
              ✅ Upload successful!<br/>
              Your submission has been received.<br/>
              <a href="${data.photoUrl}" target="_blank" class="underline text-[#0369a1]">View your artwork</a>
            </div>`;
          form.reset();
        } else {
          throw new Error(data.error || "Upload failed");
        }
      } catch (err) {
        status.innerHTML = `
          <div class="bg-red-100 text-red-800 border border-red-300 rounded-md p-3 mt-4">
            ❌ ${err.message || "Something went wrong. Please try again."}
          </div>`;
      }
    });
  </script>
</Layout>
