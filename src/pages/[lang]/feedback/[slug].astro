---
export const prerender = true;

import Layout from "../../../layouts/BaseLayout.astro";
import eventsData from "../../../data/events.translated.json";
import { t } from "../../../utils/t";
import { getSeoMeta } from "../../../utils/seo";
import fs from "fs";
import path from "path";
import { getPrivacyData } from "../../../utils/privacy";
import Likert from "../../../components/Likert.astro";

export async function getStaticPaths() {
  const langs = ["en", "de"];
  const paths = langs.flatMap((lang) =>
    (eventsData[lang as keyof typeof eventsData] ?? []).map((event) => ({
      params: { lang, slug: event.slug },
    }))
  );
  return paths;
}

const { lang, slug } = Astro.params;

const supportedLangs = ["en", "de"];
if (!supportedLangs.includes(lang))
  throw new Error(`Invalid language: ${lang}`);

const events = eventsData[lang as keyof typeof eventsData] ?? eventsData["en"];
const event = events.find((e: any) => e.slug === slug);
if (!event) throw new Error(`No event found for slug: ${slug}`);

const imageFilePath = path.resolve(`./public/events/${event.slug}.jpg`);
const hasImage = fs.existsSync(imageFilePath);

const descEn = `Give feedback for ${event.title} to help MHG Ingolstadt improve future events.`;
const descDe = `Geben Sie Feedback zu ${event.title}, um zukünftige Veranstaltungen der MHG Ingolstadt zu verbessern.`;

const { title, description, url, imageUrl } = getSeoMeta({
  lang,
  titleEn: `Feedback – ${event.title} – MHG Ingolstadt`,
  titleDe: `Feedback – ${event.title} – MHG Ingolstadt`,
  descEn,
  descDe,
  slug: `feedback/${slug}`,
  image: hasImage ? `/events/${event.slug}.jpg` : null,
});

const API_ENDPOINT = "/api/feedback";
const BACK_URL = `/${lang}/past-events/${slug}`;
const scaleNumbers = [1, 2, 3, 4, 5];

// GDPR Consent Data
const { version: consentVersion, hash: consentHash } = getPrivacyData(lang);
const consentDate = new Date().toISOString();
---

<Layout
  title={title}
  lang={lang}
  ogTitle={title}
  ogDescription={description}
  ogImage={imageUrl}
  ogUrl={url}
>
  <section class="max-w-4xl mx-auto px-4 py-10">
    <a href={BACK_URL} class="text-[#0369a1] hover:underline block mb-4">
      ← {t("feedback.backTo", lang) || "Back to"}
      {event.title}
    </a>

    <h1 class="text-3xl sm:text-4xl font-extrabold mb-6">
      📝 {t("feedback.title", lang) || "Feedback for"}
      {event.title}
    </h1>

    <div class="bg-white rounded-2xl shadow p-6">
      <form
        id="feedbackForm"
        action={API_ENDPOINT}
        method="POST"
        class="space-y-8"
      >
        <!-- Hidden Fields -->
        <input type="hidden" name="event_slug" value={slug} />
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="consent_version" value={consentVersion} />
        <input type="hidden" name="consent_hash" value={consentHash} />
        <input type="hidden" name="consent_date" value={consentDate} />

        <!-- Satisfaction -->
        <fieldset class="space-y-2">
          <legend class="block text-base font-semibold">
            {
              t("feedback.qEventSatisfaction", lang) ||
                "How satisfied were you with the event?"
            }
          </legend>
          <Likert
            name="satisfaction_overall"
            required={true}
            numbers={scaleNumbers}
            left="1"
            right="5"
          />
        </fieldset>

        <fieldset class="space-y-2">
          <legend class="block text-base font-semibold">
            {
              t("feedback.qOrgSatisfaction", lang) ||
                "How satisfied were you with the organization?"
            }
          </legend>
          <Likert
            name="satisfaction_org"
            required={true}
            numbers={scaleNumbers}
            left="1"
            right="5"
          />
        </fieldset>

        <fieldset class="space-y-2">
          <legend class="block text-base font-semibold">
            {
              t("feedback.qTopicInterest", lang) ||
                "How interesting was the topic?"
            }
          </legend>
          <Likert
            name="interest_topic"
            required={true}
            numbers={scaleNumbers}
            left="1"
            right="5"
          />
        </fieldset>

        <fieldset class="space-y-2">
          <legend class="block text-base font-semibold">
            {t("feedback.qSpeaker", lang) || "How would you rate the speaker?"}
          </legend>
          <Likert
            name="speaker_quality"
            required={true}
            numbers={scaleNumbers}
            left="1"
            right="5"
          />
        </fieldset>

        <!-- Discovery -->
        <fieldset class="space-y-2">
          <legend class="block text-base font-semibold">
            {
              t("feedback.qDiscovery", lang) ||
                "How did you hear about the event?"
            }
          </legend>
          <div class="space-y-2">
            <label class="flex items-center gap-2"
              ><input type="radio" name="discovery_source" value="whatsapp" /> WhatsApp</label
            >
            <label class="flex items-center gap-2"
              ><input type="radio" name="discovery_source" value="instagram" /> Instagram</label
            >
            <label class="flex items-center gap-2"
              ><input type="radio" name="discovery_source" value="friend" /> Friend</label
            >
            <label class="flex items-center gap-2"
              ><input type="radio" name="discovery_source" value="info_booth" />
              Info Booth</label
            >
          </div>
        </fieldset>

        <!-- Improvement Suggestions -->
        <div>
          <label class="block text-base font-semibold mb-1"
            >{
              t("feedback.qImprove", lang) || "Any suggestions for improvement?"
            }</label
          >
          <textarea
            name="improvement_suggestions"
            rows="3"
            class="w-full border border-gray-300 p-2 rounded-md"></textarea>
        </div>

        <!-- Optional Contact -->
        <div class="bg-blue-50 border border-blue-100 rounded-md p-4">
          <p class="text-sm font-semibold mb-2">
            {
              t("feedback.contactOpt", lang) ||
                "Optional: Leave your contact if you want us to follow up"
            }
          </p>
          <label class="block text-sm mb-1"
            >{t("feedback.name", lang) || "Name"}</label
          >
          <input
            name="name"
            class="w-full border border-gray-300 p-2 rounded-md mb-4"
          />

          <label class="block text-sm mb-1"
            >{t("feedback.email", lang) || "Email"}</label
          >
          <input
            name="email"
            type="email"
            class="w-full border border-gray-300 p-2 rounded-md"
          />
        </div>

        <!-- GDPR Consent -->
        <div class="bg-blue-50 border border-blue-100 rounded-md p-4 mt-4">
          <label class="flex items-start gap-2">
            <input
              type="checkbox"
              name="privacy_consent"
              required
              class="mt-1 accent-[#0369a1]"
            />
            <span class="text-sm">
              {
                lang === "de"
                  ? "Ich bestätige, dass ich die Datenschutzerklärung gelesen habe und stimme der Verarbeitung meiner personenbezogenen Daten zu."
                  : "I confirm that I have read the Privacy Policy and agree to the processing of my personal data."
              }
              <a
                href={`/${lang}/privacy`}
                target="_blank"
                class="text-[#0369a1] underline ml-1"
              >
                {
                  lang === "de"
                    ? "Datenschutzerklärung anzeigen"
                    : "View Privacy Policy"
                }
              </a>
            </span>
          </label>
        </div>

        <button
          type="submit"
          class="w-full bg-[#0369a1] text-white py-3 rounded-full hover:bg-blue-800 transition"
        >
          {t("feedback.submit", lang) || "Submit Feedback"}
        </button>

        <div id="formFeedback" class="mt-4 text-sm hidden"></div>
      </form>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById("feedbackForm");
    const feedback = document.getElementById("formFeedback");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const res = await fetch(form.action, { method: "POST", body: formData });

      if (res.ok) {
        feedback.textContent = "✅ Feedback submitted successfully!";
        feedback.className =
          "mt-4 p-3 rounded-md text-green-800 bg-green-100 border border-green-300 text-sm";
        feedback.classList.remove("hidden");
        form.reset();
        setTimeout(() => {
          window.location.href = `/${formData.get("lang")}/feedback/thank-you`;
        }, 1000);
      } else {
        feedback.textContent = "❌ Something went wrong. Please try again.";
        feedback.className =
          "mt-4 p-3 rounded-md text-red-800 bg-red-100 border border-red-300 text-sm";
        feedback.classList.remove("hidden");
      }
    });
  </script>
</Layout>
