---
export const prerender = true;

import Layout from "../../layouts/BaseLayout.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import resourcesData from "../../data/resources.translated.json";
import { t } from "../../utils/t";
import { generateStaticPaths } from '../../utils/i18n';
import { getSeoMeta } from "../../utils/seo";

export async function getStaticPaths() {
  return generateStaticPaths();
}

const { lang = "en" } = Astro.params;

/* ---------- Types ---------- */
type CardItem = {
  slug?: string;
  name: string;
  description?: string;
  locationLink?: string;
  location?: string;
  tags?: string[];
};
type LinkItem = { label: string; href: string };
type ListItem = { name: string; location?: string };

type FooterAction = { label: string; href: string; external?: boolean };
type LinksFooter = {
  text?: string;
  linkText?: string;
  href?: string;
  links?: FooterAction[];
};

type ResourceSection =
  | { category: string; type: "card"; items: CardItem[] }
  | { category: string; type: "links"; items: LinkItem[]; footer?: LinksFooter }
  | { category: string; type: "list"; items: ListItem[] };

/* ---------- Load data for current lang ---------- */
const map = resourcesData as Record<string, ResourceSection[]>;
const resources: ResourceSection[] = Array.isArray(map[lang])
  ? map[lang]
  : map["en"];

/* ---------- URL helpers ---------- */
const isExternal = (href: string) => /^https?:\/\//i.test(href);
const isStaticAsset = (href: string) =>
  /^\/(pdfs|assets|images|img|files)\//i.test(href) ||
  /\.[a-z0-9]+$/i.test(href);
const buildHref = (href: string) => {
  if (!href) return "#";
  if (isExternal(href) || isStaticAsset(href)) return href;
  const clean = href.startsWith("/") ? href : `/${href}`;
  return `/${lang}${clean}`;
};

const { title, description, url, imageUrl, imageWidth, imageHeight } = getSeoMeta({
  lang,
  titleEn: "Resources – MHG Ingolstadt",
  titleDe: "Ressourcen – MHG Ingolstadt",
  descEn: "Everything you need to stay connected and supported.",
  descDe: "Alles, was Sie brauchen, um verbunden und unterstützt zu bleiben.",
  slug: "resources",
  image: null,
});
---

<Layout
  title={title}
  lang={lang}
  ogTitle={title}
  ogDescription={description}
  ogImage={imageUrl}
  ogImageWidth={imageWidth}
  ogImageHeight={imageHeight}
  ogUrl={url}
  ogKeywords="MHG Ingolstadt, Resources, Ressourcen, Support, Hilfe, MHG Resources, MHG Ressourcen, Student Resources, Studentenressourcen, Campus Resources, Campus Ressourcen, student life support, Unterstützung für das Studentenleben, mosque information, Moscheeinformationen, halal food, halal Essen, halal supermarkets, halal Supermärkte"
>

<!-- Hero Section -->
  <section class="text-center py-12 px-4 sm:px-6 md:px-8 bg-[#d7f0f7] rounded-lg max-w-6xl mx-auto mt-8">
    <h2 class="text-3xl sm:text-4xl font-bold mb-2">📚 {t('resources.title', lang)}</h2>
    <p class="text-lg mb-10 text-slate-700">
      {t('resources.description', lang)}
    </p>
  </section>

  <!-- Resource Grid -->
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6">
      {resources.map((section) => (
        <div class="break-inside-avoid bg-white rounded-xl shadow-md p-6 w-full">
          <!-- Category header (button on mobile, static on desktop) -->
          <button
            type="button"
            class="w-full flex justify-between items-center text-left text-xl font-semibold mb-4 md:cursor-default"
            onclick={`const el=document.getElementById('section-${section.category.replace(/\s+/g,'-')}'); el.classList.toggle('hidden'); this.classList.toggle('open');`}
          >
            {section.category}
            <span class="md:hidden text-slate-600 text-sm transition-transform duration-200">▼</span>
          </button>

          <!-- CARD SECTIONS -->
          {section.type === 'card' && (
            <div
              id={`section-${section.category.replace(/\s+/g, '-')}`}
              class="space-y-4 hidden md:block transition-all duration-300 ease-in-out"
            >
              {section.items.map((item) => (
                <ResourceCard
                  name={item.name}
                  locationLink={item.locationLink}
                  location={item.location}
                  description={item.description}
                  tags={item.tags}
                />
              ))}
            </div>
          )}

          <!-- LINK SECTIONS -->
          {section.type === 'links' && (
            <div
              id={`section-${section.category.replace(/\s+/g, '-')}`}
              class="hidden md:block transition-all duration-300 ease-in-out"
            >
              <div class="space-y-3">
                {section.items.map((link) => {
                  const href = buildHref(link.href);
                  const ext = isExternal(href);
                  return (
                    <a
                      href={href}
                      target={ext ? '_blank' : undefined}
                      rel={ext ? 'noopener noreferrer' : undefined}
                      class="block bg-[#2563eb] text-white py-2 px-4 rounded text-sm text-center hover:bg-[#1e40af] transition"
                    >
                      {link.label}
                    </a>
                  );
                })}
              </div>

              {section.footer && (
                <div class="mt-4 text-center space-y-3">
                  {section.footer.text && (
                    <p class="text-sm text-slate-600">
                      {section.footer.text}{' '}
                      {section.footer.linkText && section.footer.href && (
                        <a
                          href={buildHref(section.footer.href)}
                          class="text-[#0369a1] underline"
                        >
                          {section.footer.linkText}
                        </a>
                      )}
                    </p>
                  )}
                  {section.footer.links && section.footer.links.length > 0 && (
                    <div class="flex flex-wrap justify-center gap-2">
                      {section.footer.links.map((l) => {
                        const href = buildHref(l.href);
                        const ext = l.external ?? isExternal(href);
                        return (
                          <a
                            href={href}
                            target={ext ? '_blank' : undefined}
                            rel={ext ? 'noopener noreferrer' : undefined}
                            class="inline-block bg-slate-100 text-slate-800 text-sm px-3 py-1.5 rounded hover:bg-slate-200 transition"
                          >
                            {l.label}
                          </a>
                        );
                      })}
                    </div>
                  )}
                </div>
              )}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Small style block for rotating arrow -->
  <style is:global>
    button.open span {
      transform: rotate(180deg);
    }
  </style>
</Layout>
