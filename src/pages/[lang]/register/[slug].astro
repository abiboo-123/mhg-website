---
export const prerender = true;

import Layout from "../../../layouts/BaseLayout.astro";
import eventsData from "../../../data/events.translated.json";
import { t } from "../../../utils/t";
import fs from "fs";
import path from "path";
import { getSeoMeta } from "../../../utils/seo";
import { getPrivacyData } from "../../../utils/privacy";

export async function getStaticPaths() {
  const langs = ["en", "de"];
  const paths = langs.flatMap((lang) =>
    (eventsData[lang as keyof typeof eventsData] ?? []).map((event) => ({
      params: { lang, slug: event.slug },
    }))
  );
  return paths;
}

const { lang, slug } = Astro.params;
const supportedLangs = ["en", "de"];

if (!supportedLangs.includes(lang))
  throw new Error(`Invalid language: ${lang}`);

const events = eventsData[lang as keyof typeof eventsData] ?? eventsData["en"];
const event = events.find((e: any) => e.slug === slug);
if (!event) throw new Error(`No event found for slug: ${slug}`);

const imageFilePath = path.resolve(`./public/events/${event.slug}.jpg`);
const hasImage = fs.existsSync(imageFilePath);

const descEn = `Register now for ${event.title} at MHG Ingolstadt!`;
const descDe = `Jetzt für ${event.title} bei MHG Ingolstadt registrieren!`;

const { title, description, url, imageUrl } = getSeoMeta({
  lang,
  titleEn: `Register – ${event.title} – MHG Ingolstadt`,
  titleDe: `Anmeldung – ${event.title} – MHG Ingolstadt`,
  descEn,
  descDe,
  slug: `register/${slug}`,
  image: hasImage ? `/events/${event.slug}.jpg` : null,
});

const BACK_URL = `/${lang}/events/${slug}`;
const API_ENDPOINT = "/api/register";

// GDPR Privacy Data
const { version: consentVersion, hash: consentHash } = getPrivacyData(lang);
const consentDate = new Date().toISOString();
---

<Layout
  title={title}
  lang={lang}
  ogTitle={title}
  ogDescription={description}
  ogImage={imageUrl}
  ogUrl={url}
>
  <section class="max-w-3xl mx-auto px-4 py-12">
    <a
      href={BACK_URL}
      class="text-sm text-[#0369a1] hover:underline block mb-6"
    >
      ← {t("events.backToEvent", lang)}
      {event.title}
    </a>

    <h1 class="text-3xl font-bold mb-6">
      📝 {t("events.regesterForEvent", lang)}
      {event.title}
    </h1>

    <div class="bg-white rounded-2xl shadow p-6">
      <form
        id="eventForm"
        action={API_ENDPOINT}
        method="POST"
        class="space-y-6"
      >
        <!-- Hidden event and tracking data -->
        <input type="hidden" name="event_slug" value={slug} />
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="consent_version" value={consentVersion} />
        <input type="hidden" name="consent_hash" value={consentHash} />
        <input type="hidden" name="consent_date" value={consentDate} />

        <!-- Name -->
        <div>
          <label class="block text-sm font-medium mb-1"
            >{t("contact.formName", lang)}</label
          >
          <input
            type="text"
            name="name"
            required
            class="w-full border border-gray-300 p-2 rounded-md focus:ring-2 focus:ring-[#0369a1]"
          />
        </div>

        <!-- Email -->
        <div>
          <label class="block text-sm font-medium mb-1"
            >{t("contact.email", lang)}</label
          >
          <input
            type="email"
            name="email"
            required
            class="w-full border border-gray-300 p-2 rounded-md focus:ring-2 focus:ring-[#0369a1]"
          />
        </div>

        <!-- Companionship -->
        <div>
          <p class="block text-sm font-medium mb-1">{t("events.Q1", lang)}</p>
          <div
            class="flex flex-col sm:flex-row sm:space-x-4 space-y-2 sm:space-y-0"
          >
            <label class="flex items-center gap-2">
              <input type="radio" name="companionship" value="alone" required />
              <span>{t("events.Q1.option1", lang)}</span>
            </label>
            <label class="flex items-center gap-2">
              <input
                type="radio"
                name="companionship"
                value="with_someone"
                required
              />
              <span>{t("events.Q1.option2", lang)}</span>
            </label>
          </div>
        </div>

        <!-- GDPR Consent -->
        <div class="bg-blue-50 border border-blue-100 rounded-md p-4">
          <label class="flex items-start gap-2">
            <input
              type="checkbox"
              name="privacy_consent"
              required
              class="mt-1 accent-[#0369a1]"
            />
            <span class="text-sm">
              {
                lang === "de"
                  ? "Ich bestätige, dass ich die Datenschutzerklärung gelesen habe und stimme der Verarbeitung meiner personenbezogenen Daten zu."
                  : "I confirm that I have read the Privacy Policy and agree to the processing of my personal data."
              }
              <a
                href={`/${lang}/privacy`}
                target="_blank"
                class="text-[#0369a1] underline ml-1"
              >
                {
                  lang === "de"
                    ? "Datenschutzerklärung anzeigen"
                    : "View Privacy Policy"
                }
              </a>
            </span>
          </label>
        </div>

        <button
          type="submit"
          class="w-full bg-[#0369a1] text-white py-3 rounded-full hover:bg-blue-800 transition"
        >
          {t("events.submitBTN", lang)}
        </button>

        <div id="formFeedback" class="mt-4 text-sm hidden"></div>
      </form>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById("eventForm");
    const feedback = document.getElementById("formFeedback");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
      });

      if (response.ok) {
        feedback.textContent =
          form.lang === "de"
            ? "✅ Anmeldung erfolgreich! Vielen Dank!"
            : "✅ Registration successful! Thank you!";
        feedback.className =
          "mt-4 p-3 rounded-md text-green-800 bg-green-100 border border-green-300 text-sm";
        feedback.classList.remove("hidden");
        form.reset();
        setTimeout(() => {
          window.location.href = `/${formData.get("lang")}/register/thank-you`;
        }, 1000);
      } else {
        feedback.textContent =
          form.lang === "de"
            ? "❌ Fehler bei der Anmeldung. Bitte erneut versuchen."
            : "❌ Registration failed. Please try again.";
        feedback.className =
          "mt-4 p-3 rounded-md text-red-800 bg-red-100 border border-red-300 text-sm";
        feedback.classList.remove("hidden");
      }
    });
  </script>
</Layout>
