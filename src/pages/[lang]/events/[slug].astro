---
export const prerender = true;

import Layout from "../../../layouts/BaseLayout.astro";
import rawEventsData from "../../../data/events.translated.json";
import { t } from "../../../utils/t.js";
import fs from "fs";
import path from "path";
import { generateStaticPathsForEventSlugs } from "../../../utils/i18n";
import { getSeoMeta } from "../../../utils/seo";

export async function getStaticPaths() {
  return generateStaticPathsForEventSlugs();
}

type Event = {
  slug: string;
  title: string;
  date: string;
  location: string;
  description: string;
  tags?: string[];
  speakers?: string[];
  language?: string[];
  registerAvailable?: boolean;
  registrationLink?: string;
};

const baseUrl = "https://mhg-website-phi.vercel.app";

const lang = Astro.params.lang as string;
const slug = Astro.params.slug as string;
const supportedLangs = ["en", "de"];

if (!supportedLangs.includes(lang)) {
  throw new Error(`Invalid language: ${lang}`);
}

const eventsData = rawEventsData as Record<string, Event[]>;
const translatedEvents = eventsData[lang] ?? eventsData["en"];
const event = translatedEvents.find((e: Event) => e.slug === slug);

const englishLanguageLabels: Record<string, string> = {
  en: "English",
  de: "German",
};
const germanLanguageLabels: Record<string, string> = {
  en: "Englisch",
  de: "Deutsch",
};

if (!event) {
  throw new Error(`Event not found for slug: ${slug}`);
}

const imageFilePath = path.resolve(`./public/events/${event.slug}.jpg`);
const hasImage = fs.existsSync(imageFilePath);

// ✅ Generate SEO metadata with corrected image URL
const { title, description, url, imageUrl, imageWidth, imageHeight } =
  getSeoMeta({
    lang,
    titleEn: `${event.title} – MHG Ingolstadt`,
    titleDe: `${event.title} – MHG Ingolstadt`,
    descEn: event.description.substring(0, 150) + "...",
    descDe: event.description.substring(0, 150) + "...",
    slug: `events/${event.slug}`,
    image: hasImage ? `/events/${event.slug}.jpg` : null,
  });
---

<Layout
  title={title}
  lang={lang}
  ogTitle={title}
  ogDescription={description}
  ogImage={imageUrl}
  ogImageWidth={imageWidth}
  ogImageHeight={imageHeight}
  ogUrl={url}
  ogKeywords={`${event.title} event, ${event.tags?.join(", ")}, mhg ${event.title} event, Ingolstadt ${event.title} event, MHG Ingolstadt`}
  ogType="article"
>
  <section class="max-w-3xl mx-auto px-4 py-12">
    <a
      href={`/${lang}/events`}
      class="inline-block mb-4 text-[#0369a1] hover:underline text-sm"
    >
      ← {t("events.backToAllEvents", lang)}
    </a>

    <h1 class="text-3xl font-bold mb-4">{event.title}</h1>

    {
      hasImage && (
        <div class="w-full bg-white flex justify-center items-center mb-6">
          <img
            src={`${baseUrl}/events/${event.slug}.jpg`}
            alt={event.title}
            width="1200"
            height="630"
            class="w-full h-auto object-contain rounded-md"
          />
        </div>
      )
    }

    <p class="text-sm text-gray-500 mb-2">📅 {event.date}</p>
    <p class="text-sm text-gray-500 mb-4">📍 {event.location}</p>
    <p class="mb-6 whitespace-pre-line">{event.description}</p>

    {
      event.speakers && event.speakers.length > 0 && (
        <p class="text-sm text-gray-700 mb-2">
          🎤 {t("events.speaker", lang)}: {event.speakers.join(", ")}
        </p>
      )
    }

    {
      event.language && event.language.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-2">
          {event.language.map((code) => (
            <span class="bg-slate-100 text-slate-600 text-xs px-2 py-1 rounded-full">
              🗣{" "}
              {lang === "en"
                ? englishLanguageLabels[code]
                : germanLanguageLabels[code]}
            </span>
          ))}
        </div>
      )
    }

    {
      event.tags && (
        <div class="flex flex-wrap gap-2 mb-6">
          {event.tags.map((tag) => (
            <span class="bg-gray-100 text-gray-700 text-xs px-3 py-1 rounded-full">
              #{tag}
            </span>
          ))}
        </div>
      )
    }

    {
      event.registerAvailable && (
        <a
          href={
            event.registrationLink
              ? event.registrationLink
              : `/${lang}/register/${event.slug}`
          }
          target={event.registrationLink ? "_blank" : "_self"}
          rel={event.registrationLink ? "noopener noreferrer" : undefined}
          class="inline-block bg-[#0369a1] text-white py-2 px-4 rounded hover:bg-blue-800 transition"
        >
          {t("events.registerNow", lang)}
        </a>
      )
    }
  </section>
</Layout>
