---
import React from "react";
import AdminLayout from "../../components/admin/Layout";
import LogsComponent from "../../components/admin/Logs";
import "../../styles/global.css";
const user = Astro.locals.user;
const role = Astro.locals.role;
if (!user || !role) {
  throw new Error("User not found in locals");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin – Audit Logs</title>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <AdminLayout role=`${role}`>
      <section class="max-w-6xl mx-auto">
        <header class="flex items-center justify-between mb-8 border-b pb-3">
          <div>
            <h1 class="text-3xl font-bold text-slate-800">📝 Audit Logs</h1>
            <p class="text-slate-500 text-sm mt-1">
              Review administrator actions performed across the system
            </p>
          </div>
        </header>

        <LogsComponent client:load />
      </section>
    </AdminLayout>
  </body>
</html>
