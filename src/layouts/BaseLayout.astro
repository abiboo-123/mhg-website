---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

const baseUrl = "https://mhg-website-phi.vercel.app";

const {
  title,
  lang,
  ogTitle,
  ogDescription,
  ogImage,
  ogUrl,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType,
} = Astro.props;
---

<html lang={lang}>
  <head>
    <!-- ✅ Dynamic Title -->
    <title>{ogTitle}</title>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <!-- ✅ Dynamic Keywords -->
    {
      Astro.props.ogKeywords && (
        <meta name="keywords" content={Astro.props.ogKeywords} />
      )
    }

    <!-- ✅ Dynamic Description -->
    <meta name="description" content={ogDescription} />

    <!-- ✅ Google Site Verification -->
    <meta
      name="google-site-verification"
      content="CLKllNaEJXeyiT-iH-TcxmNLyxcos33qn3PtsYtvkRw"
    />

    <!-- ✅ Canonical -->
    <link rel="canonical" href={ogUrl} />

    <!-- ✅ Multilingual SEO Links -->
    <link rel="alternate" href={`${baseUrl}/en`} hreflang="en" />
    <link rel="alternate" href={`${baseUrl}/de`} hreflang="de" />
    <link rel="alternate" href={`${baseUrl}/`} hreflang="x-default" />

    <!-- ✅ Open Graph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:type" content={ogType || "website"} />

    <!-- ✅ Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon for most browsers -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />

    <!-- PNG icon for modern browsers -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Apple Touch Icon (iPhone/iPad) -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Web App Manifest (optional but recommended) -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Shortcut Icon  -->
    <link rel="shortcut icon" href="/favicon.ico" />
  </head>

  <body class="bg-[#eaf7fb] text-slate-800 font-sans">
    <Header lang={lang} />
    <main class="min-h-screen animate-fadeInUp">
      <slot />
    </main>
    <Footer lang={lang} />
    <SpeedInsights />
    <Analytics />
  </body>
</html>
