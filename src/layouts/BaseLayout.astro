---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

const baseUrl = "https://mhg-website-phi.vercel.app";

const {
  title = "MHG Ingolstadt e. V.", // ✅ This becomes the <title> tag
  lang = "en",
  ogTitle = title,
  ogDescription = lang === "de"
    ? "Trete der MHG Ingolstadt bei für islamische Veranstaltungen, Gemeinschaft und wohltätige Initiativen."
    : "Join MHG Ingolstadt for Islamic events, community, and charity initiatives.",
  ogImage = `${baseUrl}/assets/MHG_Logo.svg`,
  ogUrl = lang === "de" ? `${baseUrl}/de` : `${baseUrl}/en`,
} = Astro.props;
---

<html lang={lang}>
  <head>
    <!-- ✅ Dynamic Title -->
    <title>{ogTitle}</title>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <!-- ✅ Dynamic Description -->
    <meta name="description" content={ogDescription} />

    <!-- ✅ Google Site Verification -->
    <meta
      name="google-site-verification"
      content="CLKllNaEJXeyiT-iH-TcxmNLyxcos33qn3PtsYtvkRw"
    />

    <!-- ✅ Canonical -->
    <link rel="canonical" href={ogUrl} />

    <!-- ✅ Multilingual SEO Links -->
    <link rel="alternate" href={`${baseUrl}/en`} hreflang="en" />
    <link rel="alternate" href={`${baseUrl}/de`} hreflang="de" />
    <link rel="alternate" href={`${baseUrl}/`} hreflang="x-default" />

    <!-- ✅ Open Graph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:type" content="website" />

    <!-- ✅ Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body class="bg-[#eaf7fb] text-slate-800 font-sans">
    <Header lang={lang} />
    <main class="min-h-screen animate-fadeInUp">
      <slot />
    </main>
    <Footer lang={lang} />
    <SpeedInsights />
    <Analytics />
  </body>
</html>
