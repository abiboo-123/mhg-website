---
// FILE IS ARVIVED AND NOT USED
import { t } from '../utils/t';

const { title, time, location, description, slug, lang } = Astro.props;
---

<div class="bg-gray-100 rounded-xl shadow-sm p-6 flex flex-col justify-between opacity-95">
  <div>
    <h3 class="text-xl font-semibold mb-2 text-gray-700">🎯 {title}</h3>
    <p class="text-sm mb-1 text-gray-600">📅 {time}</p>
    <p class="text-sm mb-2 text-gray-600">📍 {location}</p>
    <p class="text-sm text-slate-600 line-clamp-2">{description}</p>
  </div>

  <div class="mt-4 flex flex-col gap-2">
    <!-- Past Event label instead of register button -->
    <div class="text-center py-2 text-sm font-medium text-gray-500 border border-gray-300 rounded">
      {t('pastEvents.pastEvent', lang) || 'Past Event'}
    </div>

    <!-- Still show "View Event" to view event details -->
    <a href={`/${lang}/past-events/${slug}`} class="bg-gray-700 text-white text-center py-2 rounded hover:bg-gray-800 transition">
      {t('pastEvents.viewEvent', lang)}
    </a>
  </div>
</div>
