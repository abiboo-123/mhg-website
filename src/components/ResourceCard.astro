---
const {
  name,
  locationLink,
  location,
  description,
  tags = [],
  partner,
} = Astro.props;

// Utility function to normalize tags
const normalize = (s: any) =>
  s
    ?.toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .trim();

// List of alcohol keywords (kept for tag coloring)
const alcoholWords = [
  // EN
  "alcohol",
  "alcohols",
  "alcoholes",
  "serve alcohol",
  "serves alcohol",
  // DE
  "alkohol",
  "alkoholisch",
  "alkoholausschank",
  "alkoholische getranke",
  // FR
  "alcool",
  "boissons alcoolisees",
  // AR
  "كحول",
  "مشروبات كحولية",
  "يقدم الكحول",
].map(normalize);
---

<div
  class={`rounded-xl shadow-md p-4 ${
    partner
      ? "bg-green-50 border-2 border-green-600 ring-1 ring-green-400/50 shadow-[0_0_12px_rgba(34,197,94,0.25)] hover:ring-green-500/70 hover:shadow-[0_0_20px_rgba(34,197,94,0.35)] transition-all"
      : ""
  }`}
>
  <h4 class="text-lg font-semibold mb-1">{name}</h4>

  <p class="text-sm text-slate-600 mb-1">
    📍{" "}
    {
      locationLink ? (
        <a
          href={locationLink}
          target="_blank"
          title="Open in Google Maps"
          class="underline text-blue-600 hover:text-blue-800 transition"
          aria-label={`Open location of ${name} in Google Maps`}
        >
          {location}
        </a>
      ) : (
        <span>{location}</span>
      )
    }
  </p>

  <p class="text-sm mb-2">{description}</p>

  {
    tags?.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-2">
        {tags.map((tag: string) => {
          const tagNorm = normalize(tag);

          const isAlcoholTag = alcoholWords.some(
            (w) => tagNorm === w || tagNorm.includes(w)
          );

          const baseClass = "text-xs px-2 py-1 rounded-full";
          const redClass = "bg-red-100 text-red-700";
          const normalClass = "bg-[#e0f2fe] text-[#0369a1]";

          const appliedClass = isAlcoholTag ? redClass : normalClass;

          return <span class={`${appliedClass} ${baseClass}`}>{tag}</span>;
        })}
      </div>
    )
  }
</div>
