---
const { name, locationLink, location, description, tags = [] } = Astro.props;
---

<div class="bg-white rounded-xl shadow-md p-4">
  <h4 class="text-lg font-semibold mb-1">{name}</h4>
  <p class="text-sm text-slate-600 mb-1">
    📍 <a href={locationLink} target="_blank" class="underline text-blue-600 hover:text-blue-800 transition"> {location} </a>
  </p>
  <p class="text-sm mb-2">{description}</p>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-2">
      {tags.map((tag: string) => {
        const isAlcoholTag =
          tag.toLowerCase() === 'alcoholes' || tag.toLowerCase() === 'serve alcohol';
        const baseClass =
          'text-xs px-2 py-1 rounded-full';
        const redClass =
          'bg-red-100 text-red-700';
        const normalClass =
          'bg-[#e0f2fe] text-[#0369a1]';
  
        return (
          <span class={`${isAlcoholTag ? redClass : normalClass} ${baseClass}`}>{tag}</span>
        );
      })}
    </div>
  )}
  
</div>
